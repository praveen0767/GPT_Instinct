# ── CPU Dockerfile ────────────────────────────────────────────────────────────
# Optimised for CPP-only inference (EasyOCR + ONNX-quantized TrOCR).
# No CUDA required.  p50 latency ~2-4s on 2vCPU.
#
# Build:
#   docker build -f Dockerfile.cpu -t agm-ocr-cpu:latest .
# Run:
#   docker run -p 8000:8000 agm-ocr-cpu:latest
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TORCH_COMPILE_DISABLE=1 \
    OMP_NUM_THREADS=2

# System deps (OpenCV headless, libGL)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 libsm6 libxrender1 libxext6 libgl1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install CPU PyTorch first (smaller wheel)
RUN pip install --no-cache-dir \
    torch==2.2.2+cpu torchvision==0.17.2+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# Install project requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY . .

# Pre-create runtime directories
RUN mkdir -p debug_artifacts failed_cases logs data/calibration reports models/weights

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
    CMD curl -f http://localhost:8000/health || exit 1

# Start server
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--loop", "asyncio"]
